# Prepare the development image and PostgreSQL image online before offline use.
APP_ENV=offline
COMPOSE_PROJECT_NAME=jsc-ticketing-offline
TICKETING_API_IMAGE=jsc-ticketing-api:development
TICKETING_API_PORT=8187
TICKETING_DB_PASSWORD_FILE=./secrets/offline/db_password.txt
TICKETING_NETWORK_SUBNET=10.254.242.0/28
TICKETING_NETWORK_INTERNAL=true
TICKETING_WEB_IMAGE=jsc-ticketing-web:development
TICKETING_WEB_PORT=8187
TICKETING_WEB_SUBNET=10.254.244.0/28
AUTH_MODE=password

# Local dummy check only; this is not antivirus protection.
MALWARE_SCANNER_MODE=demo
ALLOW_DEMO_INTEGRATIONS=true
