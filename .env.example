# Development only; export variables into your shell or pass --env-file explicitly.
# No real secrets belong in this file. Replace before running Compose.
POSTGRES_PASSWORD=
TICKETING_API_PORT=8186
# For native PHP against your own dedicated PostgreSQL database:
DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=ticketing
DB_USER=ticketing
DB_PASSWORD=
# DB_PASSWORD_FILE can point to a private mounted secret instead of DB_PASSWORD.
