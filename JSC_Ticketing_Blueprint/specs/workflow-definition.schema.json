{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jsc:ticketing:workflow-definition:v1",
  "title": "JSC Ticketing versioned workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "version",
    "owner_department",
    "initiators",
    "nodes",
    "edges",
    "published_policy"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,80}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner_department": {
      "type": "string",
      "minLength": 2
    },
    "category_code": {
      "type": "string"
    },
    "initiators": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "everyone",
            "role",
            "position",
            "station",
            "province",
            "national_grant"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "published_policy": {
      "type": "object",
      "required": [
        "allow_loops",
        "default_timezone"
      ],
      "properties": {
        "allow_loops": {
          "type": "boolean"
        },
        "default_timezone": {
          "type": "string"
        },
        "require_second_approver": {
          "type": "boolean"
        }
      }
    },
    "cc_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sla": {
      "type": "object"
    },
    "intake_schema": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][A-Za-z0-9_-]{1,48}$"
        },
        "type": {
          "enum": [
            "start",
            "intake",
            "task",
            "claim_pool",
            "decision",
            "route",
            "approval",
            "parallel_fork",
            "parallel_join",
            "request_info",
            "timer",
            "escalation",
            "notification",
            "webhook",
            "resolve",
            "close",
            "end"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "config": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "when": {
          "type": "object"
        },
        "otherwise": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
